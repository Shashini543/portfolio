# Web3Forms access key — get yours at https://web3forms.com
# Used by the contact form (components/contact/Contact.tsx) to submit
# messages directly to your email without a backend.
# This is exposed to the browser (NEXT_PUBLIC_ prefix) because Web3Forms
# submissions happen client-side; that's expected and safe for this key.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
